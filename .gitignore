# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# impeccable design skill (local-only; critique snapshots under .impeccable/critique/ are shared)
.impeccable/hook.cache.json
.impeccable/config.local.json

# generated Prisma client — rebuilt by the `postinstall` script (keeps Vercel builds working)
/src/generated/prisma

# Prisma installs its skill docs into .agents/skills/ and mirrors them into
# .claude/ and .windsurf/ as ABSOLUTE-path symlinks, which break on any other
# machine. The real content in .agents/skills/ is committed; these mirrors are
# machine-local and get regenerated by any `prisma` command.
/.claude/skills/prisma-*
/.windsurf/
